# Backend
PORT=4000
# Folder tabel JSON (pengganti database sementara). Relatif terhadap root repo.
DATA_DIR=data/db
# Token admin untuk POST /api/admin/* (pengganti Laravel Sanctum sementara). Wajib diisi di produksi.
ADMIN_TOKEN=ganti-dengan-token-acak
# Password untuk membuka dasbor & API (kosong = tanpa password). Cookie sesi berlaku 30 hari.
SITE_PASSWORD=
# Kunci tanda tangan cookie sesi (opsional; bila kosong diturunkan dari SITE_PASSWORD)
SESSION_SECRET=
# Cache HTTP untuk endpoint publik (detik)
CACHE_SECONDS=3600

# Collector
# WAJIB untuk target jaringan (Bagian 10.4). Kontak di User-Agent: "KDKMP-MBG-Observatorium/0.1 (+<CONTACT_EMAIL>)"
CONTACT_EMAIL=
# Jeda minimum antar request ke domain yang sama (ms) — jangan kurang dari 3000
COLLECTOR_DELAY_MS=3000
COLLECTOR_DAILY_QUOTA=500
# Browser untuk Playwright. Lokal: PLAYWRIGHT_CHANNEL=chrome (pakai Chrome terpasang) atau CHROME_PATH=/path/ke/chrome.
# Server: kosongkan keduanya lalu jalankan `npx playwright-core install chromium`.
PLAYWRIGHT_CHANNEL=
CHROME_PATH=
# Notifikasi kegagalan/blokir collector (opsional)
N8N_WEBHOOK_URL=

# Backup harian (scripts/backup.js)
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14

# Nanti (fase PostgreSQL)
# DATABASE_URL=postgres://kdkmp:kdkmp@localhost:5432/kdkmp

